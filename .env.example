# NourishAI Environment Variables Template (.env.example)
# Duplicate this file as .env and fill in your custom values

# Application Info
VITE_APP_NAME=NourishAI
VITE_APP_TAGLINE=AI-Powered Food Rescue & Sustainability Platform
VITE_APP_ENV=development
VITE_PORT=5173

# API & Backend Integration
VITE_API_BASE_URL=http://localhost:5173/api
VITE_ENABLE_MOCK_DATA=true

# AI Forecasting Engine
VITE_AI_MODEL=nourish-predict-v1
VITE_AI_CONFIDENCE_THRESHOLD=85
VITE_AI_WEATHER_ALERT_SENSITIVITY=medium

# Maps & Geolocation
VITE_MAP_PROVIDER=osm
VITE_MAP_DEFAULT_LAT=12.9716
VITE_MAP_DEFAULT_LNG=77.5946
VITE_DISPATCH_RADIUS_KM=10

# Notification Channels
VITE_ENABLE_SMS_ALERTS=false
VITE_ENABLE_PUSH_NOTIFICATIONS=true
